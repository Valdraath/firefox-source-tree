{
  "manifest_version": 3,
  "name": "Source Tree",
  "version": "1.7.5",
  "author": "Valdraath",
  "homepage_url": "https://github.com/Valdraath/firefox-source-tree",
  "description": "Chrome-style Sources tree for Firefox DevTools: browse page resources by host/folder and preview images, video, audio and text.",
  "icons": { "48": "addon-tile.svg", "96": "addon-tile.svg" },
  "devtools_page": "devtools.html",
  "background": { "scripts": ["background.js"] },
  "permissions": ["downloads"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "source-tree@valdraath",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
